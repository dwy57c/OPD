# Container image plus Student-policy and fixed τ² user model mounts.
# The active research path studies privileged-context dosage and a co-evolving
# hinter. Buyer learning-progress GRPO variables below are legacy-only.
COEVO_BASE_IMAGE=meinian-megatron-grpo:swift4.1.3-vllm0.19.1-trl0.29.1-mcore1.3.2@sha256:8c0641fd72cf18cc32ba439ed7a1fadf3fe6d5bf54cc42929c677d7cd63f4163
COEVO_RUNTIME_IMAGE=coevo-swift:4.1.3
COEVO_CONTAINER_NAME=opd-coevo-dev
COEVO_POLICY_MODEL_DIR=
# Optional separate host model for the Buyer/User. Defaults to the policy model
# in compose.yaml when unset.
COEVO_BUYER_MODEL_DIR=

# Paths inside the container. Host execution may use any absolute paths instead.
COEVO_MODEL_ROOT=/models
COEVO_MODEL_TYPE=qwen3
COEVO_POLICY_MODEL_TYPE=qwen3
COEVO_BUYER_MODEL_TYPE=qwen3
COEVO_TEMPLATE_TYPE=qwen3_nothinking
COEVO_BUYER_TEMPLATE_TYPE=qwen3
COEVO_POLICY_PATH=/models/policy
COEVO_BUYER_PATH=/models/buyer
COEVO_TAU2_SRC=/workspace/OPD/third_party/tau2-bench/src
COEVO_ALLOW_DOWNLOADS=0

# Active Student/hinter layout.
COEVO_POLICY_GPUS=0
# Deprecated Buyer/LP service layout, retained only for archived replication.
COEVO_PREVIOUS_POLICY_GPUS=4
COEVO_BUYER_GPU=1
COEVO_BUYER_ROLLOUT_GPU=2
COEVO_POLICY_TRAIN_GPUS=3
COEVO_BUYER_TRAIN_GPUS=3

# A trainable 32B Buyer can use comma-separated multi-GPU layouts. Example
# GRPO phase: shared Policy=0, Buyer rollout TP2=2,3, ZeRO-3 trainer=4,5,6,7.
# COEVO_BUYER_PATH=/models/policy
# COEVO_POLICY_GPUS=0
# COEVO_BUYER_ROLLOUT_GPUS=2,3
# COEVO_BUYER_TRAIN_GPUS=4,5,6,7
# COEVO_BUYER_TUNER_TYPE=lora
# COEVO_BUYER_DEEPSPEED=zero3
# COEVO_BUYER_ROLLOUT_ENABLE_LORA=true
# COEVO_BUYER_LORA_RANK=16
# Set only when the rollout server and trainer load the exact same immutable
# base checkpoint; this avoids a redundant full 32B sync before LoRA updates.
# COEVO_VLLM_BASE_PRELOADED=1

COEVO_POLICY_PORT=8000
COEVO_PREVIOUS_POLICY_PORT=8001
COEVO_BUYER_PORT=8002
COEVO_BUYER_ROLLOUT_PORT=8003
COEVO_BUYER_MAX_TURNS=2
COEVO_BUYER_MAX_COMPLETION_LENGTH=512
COEVO_BUYER_NUM_GENERATIONS=4
# Reference KL is an optimizer regularizer; stage learning progress remains the
# only Buyer reward. Qwen3.5 must use the explicit FlashAttention2 path because
# its default SDPA path produced non-finite full-attention gradients.
COEVO_BUYER_BETA=0.01
COEVO_BUYER_ATTN_IMPL=flash_attn
COEVO_NONFINITE_GRADIENT_ACTION=error
# COEVO_BUYER_GRADIENT_CHECKPOINTING=true

# Deprecated Buyer/LP checkpoint pair. New experiments use one frozen Student
# checkpoint for each measurement and do not start policy_previous.
COEVO_TEACHER_ANCHOR=current
COEVO_PREVIOUS_POLICY_PATH=
COEVO_PREVIOUS_POLICY_MODEL=Qwen3-4B
COEVO_PREVIOUS_POLICY_URL=

# Experiment reporting. W&B is the sole Trainer reporter; keep credentials in
# the runtime environment rather than this repository. Set WANDB_MODE=offline
# for isolated infrastructure smoke tests.
COEVO_REPORT_TO=wandb
COEVO_WANDB_PROJECT=opd-stage-curriculum
# WANDB_ENTITY=
# WANDB_MODE=online

# Every target is defined at a complete natural Student action boundary.
COEVO_MAX_TEACHER_TARGETS=0
# Analysis-only takeover continuation count; the training reward does not use it.
COEVO_TEACHER_VALIDATION_CONTINUATIONS=1
COEVO_BRANCH_MAX_TOKENS=256
COEVO_BUYER_PLAN_MODE=structured

# Sparse scoring configuration. Sharpening is disabled in dosage experiments so
# the target is the raw hinted distribution.
COEVO_TEACHER_GAP_TOPK=20
COEVO_TEACHER_GAP_MIN_SUPPORT_MASS=0.95
COEVO_TEACHER_GAP_EPS=1e-8
COEVO_SKILL_GATE_METRIC=forward_kl
COEVO_SKILL_GATE_LOW=0.0
COEVO_SKILL_GATE_HIGH=0.05
COEVO_SKILL_SHARPEN_T_MIN=0.7
COEVO_SKILL_GATE_EPS=1e-8
COEVO_SHARPEN_ENABLED=0
COEVO_TARGET_OPERATOR=raw
COEVO_PURIFIED_BETA=1.0
COEVO_ACTIVE_TOKEN_BUDGET=
COEVO_DATASET_SCHEMA_VERSION=4
COEVO_TARGET_SCHEMA_VERSION=2
COEVO_TEACHER_TARGET_VERSION=hint-ladder-raw-v1

# Teacher is the same policy model plus a private hint produced by a closed model.
# Keep real API keys outside this file/repository and inject them at runtime.
COEVO_TEACHER_HINT_MODE=closed_model
COEVO_HINT_LEVEL=L2_PROCEDURAL
COEVO_TEACHER_HINT_MODEL=gemini-3.1-pro-preview
COEVO_TEACHER_HINT_URL=
COEVO_TEACHER_HINT_API_KEY=

# Hinter GRPO: reward = teacher-forced usefulness - copying - token length.
COEVO_HINTER_BASE_MODEL=
COEVO_HINTER_URL=
COEVO_HINTER_MODEL=
COEVO_HINTER_API_KEY=EMPTY
COEVO_HINTER_PORT=8004
COEVO_HINTER_GPUS=1
COEVO_HINTER_MODEL_TYPE=qwen3
COEVO_HINTER_TEMPLATE=qwen3_nothinking
COEVO_HINTER_TRAIN_GPUS=2,3,4,5,6,7
COEVO_HINTER_TUNER_TYPE=full
COEVO_HINTER_COPY_WEIGHT=1.0
COEVO_HINTER_DOSE_WEIGHT=1.0
COEVO_HINTER_LENGTH_WEIGHT=0.002
COEVO_HINTER_TOKEN_CLIP=5.0
COEVO_HINTER_DOSE_BANDWIDTH=0.05
COEVO_HINTER_MAX_HINT_TOKENS=192
COEVO_HINTER_RULE_LEAK_FLOOR=1.0
COEVO_HINTER_ANCHOR_BETA=0.01
COEVO_HINTER_REWARD_TRACE_PATH=
COEVO_HINTER_NUM_GENERATIONS=4

# v1 retail/telecom tasks may include LLM-judged natural-language assertions.
# The judge is independent from the Teacher hint path. Keep
# real API keys outside this file/repository and inject them at runtime.
COEVO_NL_JUDGE_MODEL=Qwen3-4B
COEVO_NL_JUDGE_URL=http://127.0.0.1:8000
COEVO_NL_JUDGE_API_KEY=EMPTY
COEVO_NL_JUDGE_MAX_TOKENS=1024

# τ²-Bench v1.0.0 provides official train/test splits. Co-evolution only reads
# train by default; independent final evaluation reads test.
COEVO_DOMAIN=airline
COEVO_TASK_SPLIT=train
COEVO_TASK_ID=1
COEVO_EVAL_TASK_SPLIT=test

# Independent final evaluation. The official v1.0.0 example uses gpt-4.1 as
# the fixed user simulator; OPENAI_API_KEY is only needed for this step.
COEVO_EVAL_USER_MODEL=gpt-4.1
COEVO_EVAL_USER_ARGS={"temperature": 0.0}
COEVO_EVAL_NUM_TRIALS=1
COEVO_EVAL_MAX_CONCURRENCY=1
